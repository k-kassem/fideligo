# Option 1 (recommended): encrypted values
# Generate values with: npm run smtp:encrypt -- "your-strong-key"
SMTP_HOST_ENC=
SMTP_PORT_ENC=
SMTP_SECURE_ENC=
SMTP_USER_ENC=
SMTP_PASS_ENC=
MAIL_FROM_ENC=

# Option 2 (legacy fallback): plaintext values
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=your-account@gmail.com
